<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.automation</groupId>
    <artifactId>restassured-automation</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <cucumber.version>7.34.7</cucumber.version>
        <junit.version>6.1.3</junit.version>
        <rest.assured.version>6.0.1</rest.assured.version>
        <lombok.version>1.18.46</lombok.version>
        <!-- 1.21.x, not 2.x. Testcontainers 2.0 reorganised its modules — there is no
             org.testcontainers:postgresql at 2.0.5 — and every piece of documentation
             for the singleton and JUnit 5 patterns targets the 1.21 API. -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <postgresql.driver.version>42.7.13</postgresql.driver.version>
        <allure.version>2.35.4</allure.version>
        <!-- The Allure *commandline* is versioned separately from the Java libraries and is
             far ahead of them. Pointing reportVersion at allure.version asks Central for
             allure-commandline:zip:2.35.4, which has never existed — the report generation
             fails with "Cannot resolve allure commandline dependencies" while `mvn test`
             stays perfectly green, so nothing notices until someone opens the report. -->
        <allure.commandline.version>2.45.0</allure.commandline.version>
        <gson.version>2.14.0</gson.version>
        <log4j.version>2.26.1</log4j.version>
        <slf4j.version>2.0.19</slf4j.version>

        <surefire.version>3.5.6</surefire.version>
        <allure.maven.version>3.0.3</allure.maven.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Testcontainers pulls slf4j-api 1.7.x transitively. Paired with the
                 log4j-slf4j2-impl binding below — which implements the SLF4J 2.x SPI — nothing
                 binds, SLF4J falls back to its no-op logger, and every container startup
                 diagnostic is discarded. It announces itself only as one line, easily read as
                 noise:

                   SLF4J: Failed to load class "org.slf4j.impl.StaticLoggerBinder"
                   SLF4J: Defaulting to no-operation (NOP) logger implementation

                 Pinning the API to 2.x is the fix; the alternative, downgrading to the 1.x
                 binding, keeps a dead API alive to match a transitive default. -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ============================================================ Cucumber -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The JUnit *Platform* engine, replacing the JUnit 4 cucumber-junit runner.
             The old @RunWith(Cucumber.class) runner is JUnit 4 only, which is why this
             project previously depended on both JUnit 4 (transitively) and JUnit 5 while
             running neither properly. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Cucumber needs a DI container to share state between step classes. Without
             one, each step class gets its own instance and nothing can be handed from a
             When to a Then except through statics. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- =============================================================== JUnit -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ========================================================= RestAssured -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest.assured.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${rest.assured.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ================================================== Testcontainers -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PostgreSQLContainer's readiness check runs a real query over JDBC, so the
             driver is a genuine runtime need, not a leftover. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.driver.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ over JUnit's Assert: the failure messages carry the actual value and
             the surrounding context, which matters more in a suite whose failures are read
             from a CI log than from an IDE. -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>

        <!-- ========================================================= Reporting -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-cucumber7-jvm</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Attaches the actual HTTP exchange to each step. Without it an API report shows
             which scenarios passed and nothing about what was sent or returned, which is the
             only thing anyone opens an API report to find out. -->
        <!-- allure-cucumber7-jvm reports Cucumber scenarios only. The plain JUnit tests
             beside them — the schema-teeth and concurrency ones — were absent from the report
             entirely: it said 22 while the build ran 25. This adapter picks them up. -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-rest-assured</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================= Misc -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers logs through SLF4J; without a binding its container startup
             diagnostics vanish, which is exactly the output you need when a container
             will not start in CI. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!-- The suite is a JUnit Platform suite class, not a *Test class, so
                         surefire's default includes would find nothing. Being explicit
                         here is what stops `mvn test` from passing having run zero tests. -->
                    <includes>
                        <!-- The Cucumber suite, plus the plain JUnit tests that sit alongside
                             it. Both are named explicitly: surefire's defaults would find the
                             *Test classes and miss the suite entirely, and a suite that runs
                             nothing still reports BUILD SUCCESS. -->
                        <include>**/RunCucumberTest.java</include>
                        <include>**/*Test.java</include>
                    </includes>
                    <!-- One JVM, so all three test classes share the single container stack
                         rather than each paying to start Postgres and PostgREST again. -->
                    <reuseForks>true</reuseForks>
                    <forkCount>1</forkCount>
                    <systemPropertyVariables>
                        <cucumber.junit-platform.naming-strategy>long</cucumber.junit-platform.naming-strategy>
                        <!-- Without this the Allure Cucumber plugin writes to ./allure-results
                             in the working directory while allure-maven reads
                             target/allure-results. Both halves look correctly configured and
                             `mvn allure:serve` renders an empty report — the reporting is
                             wired and produces nothing, which is worse than absent because it
                             looks done. The writer and the reader have to be told the same
                             path. -->
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure.maven.version}</version>
                <configuration>
                    <reportVersion>${allure.commandline.version}</reportVersion>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
